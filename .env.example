DB_USERNAME=REPLACE_WITH_USERNAME
DB_PASSWORD=REPLACE_WITH_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=pay_recon

# Host publish port only. The backend container always listens on 8080, which is what
# the healthcheck and the nginx proxy target over pay-recon-net.
APP_BACKEND_PORT=8080
# Compose service name, substituted into the frontend's nginx template. Must be
# DNS-resolvable — nginx resolves it per-request and never reads /etc/hosts.
APP_BACKEND_HOST=backend

APP_FRONTEND_PORT=6342

# Path prefix every REST endpoint is mounted under. Consumed by all three layers:
# Spring maps its controllers here, the nginx proxy location matches it, and Vite bakes
# it into the SPA bundle at build time — so changing it needs a frontend image rebuild
# (`docker compose up --build`).
APP_API_PREFIX=/api/v1
